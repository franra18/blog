---
import ProgressBar from '../components/ui/ProgressBar.astro';
import BaseLayout from './BaseLayout.astro';
const { frontmatter} = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <ProgressBar/>
  <div class="mx-auto max-w-prose">
    <h1>{frontmatter.title}</h1>
    <p>Publicado el {frontmatter.pubDate.toLocaleDateString('es-ES')}</p>
    <!-- <p><em>{frontmatter.description}</em></p> --> <!-- Descripción del post (de momento oculta) -->
    <img src={frontmatter.image.url} width="100%" alt={frontmatter.image.alt} />
    <p>Francisco Ramírez Cañadas</p>
    <article class="[&_a]:text-orange-500 [&_a]:hover:text-orange-700 [&_a]:hover:underline!">
      <slot /> <!-- MUY IMPORTANTE -->
    </article>
  </div>
</BaseLayout>
