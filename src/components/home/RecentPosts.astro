---
import { getCollection } from 'astro:content';
import PostRow from '../blog/PostRow.astro';
import ViewAllLink from "../ui/ViewAllLink.astro";

const allPosts = await getCollection('blog');
const recentPosts = allPosts
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3);
---

<section>
    <div class="mt-20">
        <div class="mb-6 flex items-center justify-between max-lg:mx-auto">
            <h2 class="text-3xl font-bold">Últimos artículos</h2>

            <ViewAllLink href={`${import.meta.env.BASE_URL}posts`} count={allPosts.length} />
        </div>

        <ul class="p-0 m-0 list-none space-y-3">
            {recentPosts.map((post) => (
                <PostRow post={post}/>
            ))}
        </ul>
    </div>
</section>
