---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/blog/PostRow.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const pageTitle = "Artículos";
---

<BaseLayout pageTitle={pageTitle}>
  <main class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6">
    <!-- Cabecera -->
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
        Artículos
      </h1>
      <p class="mt-2 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        Bitácora de desarrollo, análisis a fondo y notas de lo que voy aprendiendo.
      </p>

      <!-- Contador de artículos -->
      <div class="mt-6 flex items-center gap-2 border-b border-zinc-200/80 pb-3 font-mono text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
        <span class="text-orange-500 dark:text-orange-400">$</span>
        <span>ls posts/</span>
        <span class="ml-auto text-zinc-400 dark:text-zinc-600">({allPosts.length} entradas)</span>
      </div>
    </header>

    <!-- Lista de artículos -->
    <ul class="m-0 list-none space-y-3 p-0">
      {allPosts.map((post: any) => (
        <PostRow post={post} />
      ))}
    </ul>
  </main>
</BaseLayout>
