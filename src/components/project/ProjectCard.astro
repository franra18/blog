---
import TechChip from "./TechChip.astro";


const { project } = Astro.props;
const { name, description, technologies, github, demo } = project.data

const projectSlug = project.id.replace(/\/project\.json$/, '').replace('/project', '');
const projectUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${projectSlug}`;
---

<div class="border border-zinc-700 rounded-3xl p-6 hover:border-orange-500 transition-colors">
    <a href={projectUrl} class="text-inherit text-3xl hover:text-orange-500">
        {name}
    </a>
    <p class="mb-0 text-zinc-500 dark:text-zinc-400">{description}</p>
    <div class="flex flex-wrap gap-2 my-0 pb-2 mb-3">
        {technologies.map((technology: any) => (
            <TechChip technology={technology} />
        ))}
    </div>
    <div class="flex flex-wrap justify-between items-baseline border-t pt-2 border-t-zinc-700">
        <div class="flex gap-3">
            {demo && (<a href={demo} class="text-orange-500 hover:text-orange-400 font-mono" target="_blank" rel="noopener noreferrer">demo↗</a>)}
            {github && (<a href={github} class="text-zinc-500 hover:text-inherit font-mono" target="_blank" rel="noopener noreferrer">código↗</a>)}
        </div>
        <a href={projectUrl} class="text-zinc-500 hover:text-inherit font-mono">
            artículos →
        </a>
    </div>
</div>
