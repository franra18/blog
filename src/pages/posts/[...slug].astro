---
import { getCollection, render } from 'astro:content';
import MarkdownPostLayout from '../../layouts/MarkdownPostLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );

  const projects = new Map<string, typeof posts>();
  for (const post of posts) {
    const projectKey = post.id.split('/')[0];
    const projectPosts = projects.get(projectKey) ?? [];
    projectPosts.push(post);
    projects.set(projectKey, projectPosts);
  }

  return Array.from(projects.values()).flatMap((projectPosts) =>
    projectPosts.map((post, index) => ({
      params: { slug: post.id },
      props: {
        post,
        previousPost: projectPosts[index + 1] ?? null,
        nextPost: projectPosts[index - 1] ?? null,
      },
    }))
  );
}

const { post, previousPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<MarkdownPostLayout
    frontmatter={post.data}
    previousPost={previousPost}
    nextPost={nextPost}
>
    <Content />
</MarkdownPostLayout>
