---
import { getCollection } from 'astro:content';
import ProjectCard from '../project/ProjectCard.astro';
import ViewAllLink from "../ui/ViewAllLink.astro";

const allProjects = await getCollection('project');
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .slice(0, 3);
---

<section class="mt-20">
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-3xl font-bold">Proyectos destacados</h2>
    <ViewAllLink href={`${import.meta.env.BASE_URL}projects`} count={allProjects.length} />
  </div>

  <div class="grid grid-cols-1 gap-3 lg:grid-cols-3">
    {featuredProjects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>
