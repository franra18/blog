---
const { previousPost, nextPost } = Astro.props;
---

{(previousPost || nextPost) && (
  <nav aria-label="Navegación entre publicaciones" class="mt-12 grid gap-3 sm:grid-cols-2">
    {previousPost ? (
      <a
        href={`${import.meta.env.BASE_URL}posts/${previousPost.id}`}
        class="group flex flex-col justify-center rounded-xl border border-zinc-200/80 bg-zinc-50/50 p-3.5 text-left transition-all hover:-translate-y-0.5 hover:border-zinc-300 hover:bg-white hover:shadow-sm dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/80"
      >
        <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
          &larr; Anterior
        </span>
        <span class="mt-1 line-clamp-1 font-sans text-sm font-medium text-zinc-800 transition-colors group-hover:text-orange-600 dark:text-zinc-200 dark:group-hover:text-orange-400">
          {previousPost.data.title}
        </span>
      </a>
    ) : <div class="hidden sm:block" />}

    {nextPost ? (
      <a
        href={`${import.meta.env.BASE_URL}posts/${nextPost.id}`}
        class="group flex flex-col justify-center rounded-xl border border-zinc-200/80 bg-zinc-50/50 p-3.5 text-right transition-all hover:-translate-y-0.5 hover:border-zinc-300 hover:bg-white hover:shadow-sm dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/80"
      >
        <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
          Siguiente &rarr;
        </span>
        <span class="mt-1 line-clamp-1 font-sans text-sm font-medium text-zinc-800 transition-colors group-hover:text-orange-600 dark:text-zinc-200 dark:group-hover:text-orange-400">
          {nextPost.data.title}
        </span>
      </a>
    ) : <div class="hidden sm:block" />}
  </nav>
)}
