---
import Socials from '../layout/Socials.astro';
---

<div class="relative isolate h-115 w-full md:h-150">
    <div class="absolute inset-x-0 top-4 select-none text-center text-[clamp(3.5rem,10vw,8rem)] font-bold leading-[.8] tracking-tight text-black dark:text-white">
        <span class="block text-black dark:text-white [-webkit-text-fill-color:transparent] [-webkit-text-stroke:1px_currentColor]">FRANCISCO</span>
        <span class="block text-zinc-950 dark:text-zinc-50">RAMÍREZ</span>
    </div>
    <img
        class="absolute bottom-0 left-1/2 z-10 block w-[min(78vw,420px)] -translate-x-1/2 md:w-[min(52vw,480px)]"
        src={`${import.meta.env.BASE_URL}assets/profile-pic.png`}
        alt="Francisco Ramírez"
    />
        <div class="absolute bottom-0 left-0 z-20 max-w-44 rounded-tr-md bg-amber-50/90 p-1 dark:bg-zinc-950/90 md:bottom-12 md:max-w-64 md:rounded-none md:p-0">
        <p class="mb-2 font-mono text-sm font-bold text-orange-500">INGENIERO DE SOFTWARE</p>
        <p class="text-base leading-tight md:text-lg">Construyo soluciones digitales con código limpio, inteligencia artificial y curiosidad.</p>
    </div>
    <div class="absolute bottom-0 right-0 z-20 [&>div]:flex-col md:bottom-12">
        <Socials />
    </div>
</div>
