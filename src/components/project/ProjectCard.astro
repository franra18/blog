---
import TechChip from "./TechChip.astro";

const { project } = Astro.props;
const { name, type, description, image, technologies, github, demo } = project.data;

const projectSlug = project.id.replace(/\/project\.json$/, '').replace('/project', '');
const projectUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${projectSlug}`;
const imageUrl = image;
const hasLinks = Boolean(github || demo);
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-zinc-200/90 bg-[#faf6ed] shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-zinc-400 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-950 dark:hover:border-zinc-700">
    <!-- Barra superior de la ventana -->
    <div class="flex items-center justify-between border-b border-zinc-200/70 bg-zinc-200/40 px-3.5 py-2 dark:border-zinc-800 dark:bg-zinc-900/60">
        <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80 transition-colors group-hover:bg-rose-500"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80 transition-colors group-hover:bg-amber-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80 transition-colors group-hover:bg-emerald-500"></span>
        </div>
        <span class="font-mono text-[11px] font-medium tracking-wider text-zinc-400 dark:text-zinc-500">
            bash
        </span>
    </div>

    <!-- Cuerpo de la tarjeta -->
    <div class="flex flex-1 flex-col p-4">
        <!-- Tag de categoría -->
        <p class="mb-1 mt-0 font-mono text-[11px] font-semibold uppercase tracking-widest text-orange-600 dark:text-orange-400">
            {type}
        </p>

        <!-- Título con flecha separada -->
        <a href={projectUrl} class="group/title inline-flex items-center text-xl font-bold tracking-tight text-zinc-900 hover:text-orange-600 dark:text-zinc-100 dark:hover:text-orange-400">
            <span>{name}</span>
            <span class="ml-2 text-base text-orange-500 transition-transform group-hover/title:translate-x-1">→</span>
        </a>

        <!-- Descripción -->
        <p class="mt-1.5 mb-3 text-sm leading-snug text-zinc-600 dark:text-zinc-400">
            {description}
        </p>

        <!-- Imagen / Demo -->
        <a href={projectUrl} class="mb-3 block overflow-hidden rounded-lg border border-zinc-200/80 bg-white dark:border-zinc-800 dark:bg-zinc-900" aria-label={`Ver proyecto ${name}`}>
            <img
                src={imageUrl}
                alt={`Vista previa de ${name}`}
                class="block aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                loading="lazy"
            />
        </a>

        <!-- Zona inferior compacta -->
        <div class="mt-1 flex flex-col gap-2.5">
            <!-- Enlaces unificados -->
            {hasLinks && (
            <div class="flex flex-wrap items-center gap-2">
                {github && (
                <a
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-md border border-zinc-300/80 bg-white px-2.5 py-1 font-mono text-xs font-semibold text-zinc-800 shadow-sm transition hover:border-orange-400 hover:text-orange-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:text-orange-400"
                >
                    <span>GitHub</span>
                    <span class="text-[10px] text-zinc-400">↗</span>
                </a>
                )}
                {demo && (
                <a
                    href={demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-md border border-zinc-300/80 bg-white px-2.5 py-1 font-mono text-xs font-semibold text-zinc-800 shadow-sm transition hover:border-orange-400 hover:text-orange-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:text-orange-400"
                >
                    <span>Demo</span>
                    <span class="text-[10px] text-zinc-400">↗</span>
                </a>
                )}
            </div>
            )}

            <!-- Chips de tecnologías -->
            <div class="flex flex-wrap gap-1.5">
                {technologies.map((technology: any) => <TechChip technology={technology} />)}
            </div>
        </div>
    </div>
</article>
