---
import { getCollection } from 'astro:content';
import ProjectCard from '../project/ProjectCard.astro';

const allProjects = await getCollection('project');
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .slice(0, 3);
---

<section class="mt-20 max-lg:mx-auto">
  <div class="flex justify-between items-center">
    <h2 class="text-3xl">Proyectos destacados</h2>
    <a
      href={`${import.meta.env.BASE_URL}projects`}
      class="group inline-flex shrink-0 whitespace-nowrap items-center gap-2 rounded-full border border-zinc-200/90 bg-white/70 px-3.5 py-1.5 font-sans text-xs font-medium tracking-wide text-zinc-700 shadow-sm backdrop-blur-md transition-all hover:border-zinc-300 hover:bg-white hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900/80 dark:text-zinc-300 dark:shadow-none dark:hover:border-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-white"
    >
      <span>Ver todos</span>
      <span class="rounded-full bg-zinc-100 px-1.5 py-0.5 font-mono text-[10px] text-zinc-500 transition-colors group-hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-400 dark:group-hover:bg-zinc-700 dark:group-hover:text-zinc-200">
        {allProjects.length}
      </span>
      <span class="text-zinc-400 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-orange-500 dark:text-zinc-500 dark:group-hover:text-orange-400">
        &rarr;
      </span>
    </a>
  </div>

  <div class="grid grid-cols-1 gap-3 lg:grid-cols-3">
    {featuredProjects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>
