<button id="themeToggle" aria-label="Toggle theme" class="cursor-pointer">
  <svg 
    aria-hidden="true" 
    width="30px" 
    height="30px"
    viewBox="0 0 24 24"
    class="fill-current text-neutral-900 dark:text-neutral-100"
  >
    <use class="sun" href={`${import.meta.env.BASE_URL}assets/sprite.svg#sun`} />
    <use class="moon" href={`${import.meta.env.BASE_URL}assets/sprite.svg#moon`} />
  </svg>
</button>

<style>
  #themeToggle {
    border: 0;
    background: none;
  }
  .sun {display: inline;}
  .moon {display: none;}

  :global(.dark) .sun {display: none;}
  :global(.dark) .moon {display: inline;}
</style>

<script>
  const setupThemeToggle = () => {
    const button = document.getElementById('themeToggle');
    if (!button) return;

    // Evitar añadir múltiples listeners tras cada navegación con View Transitions de Astro
    button.replaceWith(button.cloneNode(true));
    const newButton = document.getElementById('themeToggle');
    if (!newButton) return;

    newButton.addEventListener('click', (event: MouseEvent) => {
      const element = document.documentElement;

      const toggleTheme = () => {
        element.classList.toggle('dark');
        const isDark = element.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || prefersReducedMotion) {
        toggleTheme();
        return;
      }

      // Si se activa por teclado (Enter/Espacio), clientX/Y suelen ser 0; usamos el centro del botón como respaldo
      const rect = newButton.getBoundingClientRect();
      const x = event.clientX || rect.left + rect.width / 2;
      const y = event.clientY || rect.top + rect.height / 2;

      // Distancia euclídea hacia la esquina más lejana de la ventana
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const transition = document.startViewTransition(() => {
        toggleTheme();
      });

      transition.ready.then(() => {
        document.documentElement.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`
            ]
          },
          {
            duration: 450,
            easing: 'ease-in-out',
            pseudoElement: '::view-transition-new(root)'
          }
        );
      });
    });
  };

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
