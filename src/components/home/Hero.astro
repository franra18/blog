---
const fondoClaro = `${import.meta.env.BASE_URL}assets/fondo-prueba-3.webp`;
const fondoOscuro = `${import.meta.env.BASE_URL}assets/fondo-prueba-2.webp`;
---

<section class="relative -mt-16 flex h-dvh w-full flex-col items-start justify-center bg-(image:--hero-bg-light) bg-cover bg-bottom bg-no-repeat dark:bg-(image:--hero-bg-dark)"
    style={`--hero-bg-light: url(${fondoClaro}); --hero-bg-dark: url(${fondoOscuro});`}>
    <div class="relative max-w-lg mx-5 p-5 rounded-4xl dark:max-md:bg-black/50 max-md:bg-white/50">
        <h1 class="mb-5 mt-0 text-left text-6xl font-bold max-md:text-5xl">
            Construyo cosas con sentido
        </h1>
        <p class="mt-0 text-xl">
            Ingeniero de software - Me enfoco en resolver problemas reales con código limpio, bien pensado y escalable.
        </p>
        <a class="py-3 px-4 bg-orange-500 rounded-full no-underline text-inherit font-bold inline-block hover:scale-105 transition-transform" href=`${import.meta.env.BASE_URL}assets/CV_Francisco_Ramirez_Canadas_ES.pdf` target="_blank" rel="noopener noreferrer">
            Ver currículum
        </a>
    </div>
</section>
