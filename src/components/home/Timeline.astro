---
import TechChip from "../project/TechChip.astro";

const milestones = [
    {
        date: "Abril 2026 - Junio 2026",
        role: "Ingeniero de Software (Prácticas)",
        logo: "NTTData",
        company: "NTT DATA Europe & Latam",
        highlights: [
            "Desarrollé prototipos para automatizar procesos con IA.",
            "Generé PDFs dinámicos para el proyecto internacional EPO.",
            "Lideré el diseño técnico y presenté los resultados en una demo corporativa.",
        ],
        technologies: [
            "Java", "Spring Boot", "Spring AI", "Python"
        ]
    },
    {
        date: null,
        role: "Graduado en Ingeniería del Software",
        logo: "ETSII",
        company: "Universidad de Málaga",
        highlights: [
            "Desarrollé un TFG full-stack: un Armario Virtual Inteligente.",
            "Incorporé etiquetado mediante visión artificial, APIs climáticas y un backend asíncrono.",
        ],
        technologies: [
            "React Native", "FastAPI", "Python", "MySQL", "Gemini API", "Redux Toolkit"
        ]
    },
];
---

<section aria-labelledby="timeline-title" class="w-full">
    <h2 class="mt-20 max-w-3xl text-3xl font-bold">Trayectoria</h2>

    <ol class="relative m-0 max-w-3xl list-none space-y-8 p-0 pl-8 before:absolute before:bottom-3 before:left-1.5 before:top-3 before:w-px before:bg-zinc-300 dark:before:bg-zinc-700 md:space-y-10">
        {milestones.map((milestone) => (
            <li class="relative">
                <span class="sticky top-1/2 z-5 -ml-7.75 mt-1.5 block size-3 rounded-full bg-orange-500 ring-4 ring-amber-50 dark:ring-zinc-950"></span>

                <article class="-mt-3 rounded-2xl border border-zinc-200/80 bg-white/70 p-5 shadow-sm dark:border-zinc-800/80 dark:bg-zinc-900/60 md:p-6 overflow-hidden relative hover:border-orange-400 group">
                    <div class="mb-3 flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <h3 class="my-0 text-xl font-bold text-zinc-900 dark:text-zinc-100">{milestone.role}</h3>
                            <p class="my-1 flex items-center gap-2 font-bold text-zinc-700 dark:text-zinc-300">
                                {milestone.company}
                            </p>
                        </div>
                        {milestone.date && (
                            <span class="rounded-full bg-zinc-200 px-3 py-1 font-mono text-xs text-zinc-700 dark:bg-zinc-800 dark:text-zinc-400">
                                {milestone.date}
                            </span>
                        )}
                    </div>
                    <ul class="my-0 list-disc pl-5 leading-relaxed max-w-xl text-zinc-700 dark:text-zinc-300">
                        {milestone.highlights.map((highlight) => (
                            <li>{highlight}</li>
                        ))}
                    </ul>
                    <div class="flex flex-wrap gap-2 mt-2">
                        {milestone.technologies.map((tech) => (
                            <TechChip technology={tech} />
                        ))}
                    </div>
                    {milestone.logo && (
                        <svg class="absolute size-32 -z-10 -rotate-30 group-hover:-rotate-15 group-hover:scale-125 transition-transform -right-5 -bottom-5" width="100" height="100">
                            <use href={`${import.meta.env.BASE_URL}assets/sprite.svg#${milestone.logo}`} />
                        </svg>
                    )}
                </article>
            </li>
        ))}
    </ol>
</section>
