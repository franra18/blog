---
import { getCollection } from 'astro:content';
import PostRow from '../../components/blog/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechChip from '../../components/project/TechChip.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('project');
  const allPosts = await getCollection('blog');

  return allProjects.map((projectEntry) => {
    const folderName = projectEntry.id.replace(/\/project(\.json)?$/, '');

    const filteredPosts = allPosts.filter((post) =>
      post.id.startsWith(`${folderName}/`)
    );

    return {
      params: { project: folderName },
      props: {
        project: projectEntry,
        posts: filteredPosts
      }
    };
  });
}

const { project, posts } = Astro.props;
const { name, type, description, technologies, demo, github } = project.data;
const hasLinks = Boolean(demo || github);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout pageTitle={name}>
  <main class="mx-auto max-w-4xl px-4 py-6 sm:px-6">
    <!-- Navegación superior -->
    <div class="mb-4">
      <a
        href={`${baseUrl}/projects`}
        class="group inline-flex items-center gap-1.5 font-mono text-xs text-zinc-500 transition-colors hover:text-orange-600 dark:text-zinc-400 dark:hover:text-orange-400"
      >
        <span class="transition-transform group-hover:-translate-x-1">←</span>
        <span>cd ../proyectos</span>
      </a>
    </div>

    <!-- Cabecera -->
    <header class="mb-8">
      {type && (
        <p class="mb-1 font-mono text-[11px] font-semibold uppercase tracking-widest text-orange-600 dark:text-orange-400">
          {type}
        </p>
      )}

      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
        {name}
      </h1>

      <p class="mt-2 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        {description}
      </p>

      <!-- Botones de Enlace -->
      {hasLinks && (
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md border border-zinc-300/80 bg-white px-3 py-1 font-mono text-xs font-semibold text-zinc-800 shadow-sm transition hover:border-orange-400 hover:text-orange-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:text-orange-400"
            >
              <span>GitHub</span>
              <span class="text-[10px] text-zinc-400">↗</span>
            </a>
          )}
          {demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md border border-zinc-300/80 bg-white px-3 py-1 font-mono text-xs font-semibold text-zinc-800 shadow-sm transition hover:border-orange-400 hover:text-orange-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:text-orange-400"
            >
              <span>Demo</span>
              <span class="text-[10px] text-zinc-400">↗</span>
            </a>
          )}
        </div>
      )}

      <!-- Chips de tecnologías -->
      <div class={`${hasLinks ? 'mt-3' : 'mt-4'} flex flex-wrap items-center gap-1.5`}>
        {technologies.map((technology: any) => (
          <TechChip technology={technology} />
        ))}
      </div>
    </header>

    <!-- Artículos -->
    {posts.length > 0 && (
      <section>
        <h2 class="mb-4 font-mono text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
          Artículos relacionados ({posts.length})
        </h2>

        <ul class="m-0 list-none space-y-3 p-0">
          {posts.map((post: any) => (
            <li>
              <PostRow post={post} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
