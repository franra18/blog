---
import { getCollection } from 'astro:content';
import PostRow from '../../components/blog/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  const uniqueTags = [...new Set(allPosts.map((post: any) => post.data.tags).flat())]; /* Crea un array de tags únicos a partir de todos los posts. */

  return uniqueTags.map((project) => { 
    const filteredPosts = allPosts.filter((post: any) => post.data.tags.includes(project));
    return {
      params: { project },
      props: { posts: filteredPosts }
    };
  });
}

// This function above is used to generate the static paths for each unique project in the blog posts. It retrieves all blog posts, extracts unique projects, and then creates a path for each project along with the corresponding posts that have that project. The result is an array of objects containing the project as a parameter and the filtered posts as props. This allows Astro to generate static pages for each project with the relevant blog posts displayed.

const { project } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout pageTitle={project}>
  <div class="mx-60 max-md:mx-auto">
    <h1>{project}</h1>
    <ul class="p-0 m-0 list-none">
      {posts.map((post: any) => <PostRow post={post} />)}
    </ul>
  </div>
</BaseLayout>
