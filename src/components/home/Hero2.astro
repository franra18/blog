---
const fondoClaro = `${import.meta.env.BASE_URL}assets/fondo-prueba-3.jpg`;
const fondoOscuro = `${import.meta.env.BASE_URL}assets/fondo-prueba-2.jpg`;
---

<section 
    class="relative -mt-16 flex h-dvh w-full flex-col items-start justify-center bg-[image:var(--hero-bg-light)] bg-cover bg-top bg-no-repeat dark:bg-[image:var(--hero-bg-dark)]"
    style={`--hero-bg-light: url(${fondoClaro}); --hero-bg-dark: url(${fondoOscuro});`}>
    <h1 class="relative max-w-xl px-6 text-left text-6xl font-bold max-md:text-5xl max-md:text-center">
        Construyo cosas con sentido
    </h1>
</section>
