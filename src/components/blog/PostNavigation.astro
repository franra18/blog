---
const { previousPost, nextPost } = Astro.props;
---

{(previousPost || nextPost) && (
  <nav aria-label="Navegación entre publicaciones" class="mt-12 grid gap-4 sm:grid-cols-2">
    {previousPost ? (
      <a
        href={`${import.meta.env.BASE_URL}posts/${previousPost.id}`}
        class="group flex min-h-14 flex-col justify-center rounded-lg border border-zinc-300 px-4 py-2 text-left transition-colors hover:border-orange-500 hover:bg-amber-100 dark:border-zinc-700 dark:hover:bg-zinc-900"
      >
        <span class="text-lg text-zinc-500 dark:text-zinc-400">Anterior</span>
        <span class="mt-0.5 flex items-start gap-3 text-xl text-black dark:text-white">
          <span aria-hidden="true" class="text-3xl leading-7 text-zinc-400 transition-transform group-hover:-translate-x-1">&larr;</span>
          <span>{previousPost.data.title}</span>
        </span>
      </a>
    ) : <span />}

    {nextPost && (
      <a
        href={`${import.meta.env.BASE_URL}posts/${nextPost.id}`}
        class="group flex min-h-14 flex-col justify-center rounded-lg border border-zinc-300 px-4 py-2 text-right transition-colors hover:border-orange-500 hover:bg-amber-100 dark:border-zinc-700 dark:hover:bg-zinc-900"
      >
        <span class="text-lg text-zinc-500 dark:text-zinc-400">Siguiente</span>
        <span class="mt-0.5 flex items-start justify-end gap-3 text-xl text-black dark:text-white">
          <span>{nextPost.data.title}</span>
          <span aria-hidden="true" class="text-3xl leading-7 text-zinc-400 transition-transform group-hover:translate-x-1">&rarr;</span>
        </span>
      </a>
    )}
  </nav>
)}
