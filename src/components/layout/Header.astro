---
import Navigation from './Navigation.astro';
import ThemeIcon from '../ui/ThemeIcon.astro';
const { hideOnScroll } = Astro.props;
---

<header id="site-header" class:list={['site-header pb-4 pointer-events-none', { 'hide-on-scroll': hideOnScroll }]}>
    <nav>
        <div class="nav-shell relative flex items-center justify-center gap-1 pointer-events-auto sm:gap-3">
            <a href={import.meta.env.BASE_URL} class="font-mono text-sm font-bold text-orange-600 dark:text-orange-400" aria-label="Francisco Ramírez, inicio">
                <span class="sm:hidden">FR</span>
                <span class="max-sm:hidden">francisco.ramírez</span>
            </a>
            <span class="h-5 w-px bg-zinc-300 dark:bg-zinc-700" aria-hidden="true"></span>
            <Navigation />
            <ThemeIcon />
        </div>
    </nav>
</header>

<style>
    .site-header {
        position: sticky;
        top: 1rem;
        z-index: 50;
    }

    .site-header.hide-on-scroll {
        transition: transform 200ms ease-in-out;
    }

    .site-header.hide-on-scroll.is-hidden {
        transform: translateY(calc(-100% - 1rem));
    }

    .nav-shell {
        width: fit-content;
        margin-inline: auto;
        border-radius: 9999px;
        border: 1px solid transparent;
        background-color: transparent;
        backdrop-filter: blur(0px);
        transition:
            padding 200ms ease,
            background-color 200ms ease,
            border-color 200ms ease,
            backdrop-filter 200ms ease;
    }

    .site-header.is-scrolled .nav-shell {
        padding: 0.25rem 0.75rem;
        border-color: rgb(113 113 122 / 0.45);
        background-color: rgb(255 251 235 / 0.9);
        backdrop-filter: blur(8px);
    }

    :global(.dark) .site-header.is-scrolled .nav-shell {
        background-color: rgb(9 9 11 / 0.9);
    }
</style>

<script>
    const siteHeader = document.getElementById('site-header');
    let lastScrollY = window.scrollY;

    const updateHeader = () => {
        const currentScrollY = window.scrollY;
        siteHeader?.classList.toggle('is-scrolled', currentScrollY > 24);

        if (siteHeader?.classList.contains('hide-on-scroll')) {
            const isAtTop = currentScrollY <= 24;
            const isScrollingUp = currentScrollY < lastScrollY;
            siteHeader.classList.toggle('is-hidden', !isAtTop && !isScrollingUp);
        }

        lastScrollY = currentScrollY;
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
</script>
