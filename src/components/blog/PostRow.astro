---
const { post } = Astro.props;
const { title, description, pubDate } = post.data;
const url = `/posts/${post.id}`
const href = `${import.meta.env.BASE_URL}${url.replace(/^\/+/, '')}`;
const projectName = post.id.includes('/') ? post.id.split('/')[0] : null;
---

<li class="hover:bg-amber-100 dark:hover:bg-zinc-900 transition-all group py-1 px-5 border-b border-b-zinc-700">
    <a href={href} class="flex flex-wrap gap-10 max-lg:gap-3 items-center max-lg:flex-col">
        <p class="text-black font-mono dark:text-white max-lg:mb-0 w-28 shrink-0">
            {pubDate.toLocaleDateString('es-ES')}
        </p>
        
        <div class="flex-1 min-w-0">
            <p class="text-black dark:text-white text-xl mb-0 group-hover:text-orange-600 max-lg:mt-0">
                {title}
            </p>

            <p class="text-zinc-500 dark:text-zinc-400 mt-1 max-lg:mb-0">
                {description}
            </p>
        </div>

        {projectName && (
            <p class="text-amber-100 dark:text-zinc-900 font-mono uppercase text-sm font-bold max-lg:mt-1 py-0.5 px-3 bg-orange-500 rounded-2xl ml-auto">
                {projectName}
            </p>
        )}
    </a>
</li>
