---
const socials = [
  { platform: 'github', url: 'https://github.com/franra18' },
  { platform: 'linkedin', url: 'https://www.linkedin.com/in/francisco-ramirez-canadas' },
  { platform: 'email', url: 'mailto:franciscoramirezcanadas@gmail.com' }
];
---

<div class="flex items-center gap-3 font-mono text-xs">
  {socials.map((social) => (
    <a
      href={social.url}
      target="_blank"
      rel="noopener noreferrer"
      class="tap-target inline-block py-1.5 text-zinc-500 transition-colors hover:text-orange-700 dark:text-zinc-400 dark:hover:text-orange-400"
    >
      <span>{social.platform}</span>
      <span class="text-zinc-500 dark:text-zinc-400">↗</span>
    </a>
  ))}
</div>
