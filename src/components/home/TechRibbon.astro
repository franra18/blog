---
const technologies = [
    { icon: 'Astro', viewBox: '0 0 85 107' },
    { icon: 'Java', viewBox: '0 0 256 346' },
    { icon: 'PostgreSQL', viewBox: '0 0 432.071 445.383' },
    { icon: 'MongoDB', viewBox: '0 0 120 257' },
    { icon: 'Python' },
    { icon: 'JavaScript', themeLogo: true },
    { icon: 'TailwindCSS' },
    { icon: 'Docker' },
    { icon: 'FastAPI' },
    { icon: 'Spring' },
    { icon: 'MCP', viewBox: '0 0 24 24' },
    { icon: 'Git', viewBox: '0 0 256 256' },
];

const ribbonTechnologies = [...technologies, ...technologies];
---

<section class="group relative w-full overflow-hidden border-y border-zinc-700/30 before:pointer-events-none before:absolute before:inset-y-0 before:inset-s-0 before:z-10 before:h-full before:w-16 before:bg-linear-to-r before:from-amber-50 after:pointer-events-none after:absolute after:inset-y-0 after:inset-e-0 after:z-10 after:h-full after:w-16 after:bg-linear-to-l after:from-amber-50 dark:before:from-zinc-950 dark:after:from-zinc-950" aria-label="Tecnologías que uso">
    <ul class="sr-only">
        {technologies.map(({ icon }) => <li>{icon}</li>)}
    </ul>

    <!-- Copias puramente visuales para el bucle; los lectores de pantalla leen la lista de arriba -->
    <div class="flex w-max items-center animate-[tech-ribbon-scroll_42s_linear_infinite] group-hover:[animation-play-state:paused] motion-reduce:animate-none" aria-hidden="true">
        {[false, true].map(() => (
            <div class="flex shrink-0 items-center">
                {ribbonTechnologies.map(({ icon, viewBox = '0 0 64 64', themeLogo = false }) => (
                    <div class="flex h-24 w-24 shrink-0 items-center justify-center sm:h-28 sm:w-28" title={icon}>
                        <svg viewBox={viewBox} class:list={{ 'size-10 transition-transform duration-150 hover:scale-[1.15] motion-reduce:transition-none motion-reduce:hover:scale-100': true, 'brightness-0 dark:brightness-0 dark:invert': !themeLogo, 'dark:invert': themeLogo }}>
                            <use href={`${import.meta.env.BASE_URL}assets/sprite.svg#${icon}`} />
                        </svg>
                    </div>
                ))}
            </div>
        ))}
    </div>
</section>

<style>
    @keyframes tech-ribbon-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
</style>
